# PostHog product analytics. Public, write-only project key — safe in the client bundle.
# Use the SAME key as the app: one project, so the landing page -> signup funnel is one visitor.
#
# Set this in Vercel for PRODUCTION ONLY. Left unset (local dev, preview deployments) the whole
# analytics layer is a graceful no-op: no init, no network, no window.posthog.
#
# The ingest host is not configured here — events are proxied through /ingest, and the upstream
# lives in next.config.ts.
NEXT_PUBLIC_POSTHOG_KEY=

# Canonical site URL, used for metadata, robots and sitemap. Defaults to https://lantell.io.
NEXT_PUBLIC_SITE_URL=

# The app endpoint that records the demo request and emails it. Production:
# https://app.lantell.io/api/demo-request — locally, http://localhost:3000/api/demo-request
DEMO_REQUEST_ENDPOINT=

# Shared secret for that hop. Must match DEMO_REQUEST_SECRET in the app project.
# Server-side only — never prefixed NEXT_PUBLIC_, never reaches the browser.
DEMO_REQUEST_SECRET=
